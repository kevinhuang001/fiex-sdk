{
  "schemaVersion": 2,
  "id": "org.fiex.mock",
  "name": "Core Host IPC Fixture",
  "version": "0.1.0",
  "description": "Mock native plugin used by Core process IPC tests.",
  "runtime": {
    "protocolVersion": "4.0",
    "entrypoints": {
      "linux-x86_64": "mock_plugin",
      "macos-aarch64": "mock_plugin",
      "macos-x86_64": "mock_plugin",
      "windows-x86_64": "mock_plugin.exe"
    }
  },
  "permissions": {
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": true,
      "allow": ["git"]
    },
    "folders": {
      "read": {
        "enabled": true
      },
      "create": {
        "enabled": true
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": true
      },
      "create": {
        "enabled": true
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "search": {
      "icon": "magnifying-glass",
      "scope": "global"
    }
  }
}
